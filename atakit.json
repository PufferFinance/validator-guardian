{
  "workloads": [
    {
      "name": "secure-signer",
      "version": "v0.1.8",
      "image": "automata-linux:v0.1.4-debug",
      "docker_compose": "./container/secure-signer/docker-compose.yml"
    },
    {
      "name": "validator",
      "version": "v0.1.8",
      "image": "automata-linux:v0.1.4-debug",
      "docker_compose": "./container/validator/docker-compose.yml"
    },
    {
      "name": "guardian",
      "version": "v0.1.8",
      "image": "automata-linux:v0.1.4-debug",
      "docker_compose": "./container/guardian/docker-compose.yml"
    }
  ],
  "platforms": ["gcp"],
  "disks": [
    {
      "name": "secure-signer-data",
      "size": "10GB",
      "encryption": {
        "enable": true,
        "encryption_key_security": "standard"
      }
    },
    {
      "name": "validator-data",
      "size": "10GB",
      "encryption": {
        "enable": true,
        "encryption_key_security": "standard"
      }
    },
    {
      "name": "guardian-data",
      "size": "10GB",
      "encryption": {
        "enable": true,
        "encryption_key_security": "standard"
      }
    }
  ],
  "deployment": {
    "secure-signer-tdx": {
      "workload": "secure-signer",
      "platforms": {
        "gcp": { "vmtype": "c3-standard-4", "region": "europe-west4-a" }
      }
    },
    "validator-tdx": {
      "workload": "validator",
      "platforms": {
        "gcp": { "vmtype": "c3-standard-4", "region": "europe-west4-a" }
      }
    },
    "guardian-tdx": {
      "workload": "guardian",
      "platforms": {
        "gcp": { "vmtype": "c3-standard-4", "region": "europe-west4-a" }
      }
    }
  }
}
